# Copy this file to .env and fill in the values.
# Get CLIENT_ID / CLIENT_SECRET from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Filled in automatically by strava_auth.py the first time you run it.
STRAVA_REFRESH_TOKEN=

# Optional: enables `sync-to-strava --from-api RECORD_ID`, fetching a
# workout directly from Liftosaur's REST API instead of a hand-written
# JSON file. Requires Liftosaur Premium — generate at Settings > API Keys
# in the Liftosaur app. Leave unset to keep using the MCP + JSON-file flow.
LIFTOSAUR_API_KEY=
